{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // The pure outbox modules import each other with .ts extensions so
    // Node's test runner (type stripping) can load them; tsc never emits.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
