# Copy to .env.local for local development. .env.local is gitignored and
# overrides .env. Only EXPO_PUBLIC_* values belong here: they are bundled into
# the app and readable by anyone who has it.
#
# Never put a Supabase secret key or service-role key in the mobile app.
#
# Hosted development project (takalex-development):
EXPO_PUBLIC_SUPABASE_URL=https://omtmqtgmbtkutadbkjzv.supabase.co
# Local stack instead (with `adb reverse tcp:54321 tcp:54321`):
# EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Publishable key (sb_publishable_...), from `supabase status` locally or the
# project's API settings. Never the secret or service-role key.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Optional: Sentry DSN for error reporting. Leave empty to disable.
EXPO_PUBLIC_SENTRY_DSN=
